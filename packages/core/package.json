{
  "name": "@smug-ui/core",
  "version": "0.1.0",
  "description": "Shared types, variant presets, accessibility helpers and headless state helpers for Sun UI.",
  "homepage": "https://github.com/tahmidbintaslim/sun-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahmidbintaslim/sun-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tahmidbintaslim/sun-ui/issues"
  },
  "keywords": [
    "headless",
    "primitives",
    "utilities",
    "typescript"
  ],
  "author": "Tahmid Bin Taslim Rafi (https://github.com/tahmidbintaslim)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smug-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@types/react": "^19.0.0",
    "eslint-plugin-storybook": "^10.6.3",
    "typescript": "^5.9.3"
  }
}
