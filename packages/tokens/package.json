{
  "name": "@smug-ui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Sun UI: colors, sizing, typography and animations.",
  "homepage": "https://github.com/tahmidbintaslim/sun-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahmidbintaslim/sun-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/tahmidbintaslim/sun-ui/issues"
  },
  "keywords": [
    "design-tokens",
    "colors",
    "spacing",
    "typography",
    "css-variables"
  ],
  "author": "Tahmid Bin Taslim Rafi (https://github.com/tahmidbintaslim)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-links": "^10.1.4",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.24.2",
    "eslint-plugin-storybook": "^10.1.4",
    "typescript": "^5.9.3"
  }
}
