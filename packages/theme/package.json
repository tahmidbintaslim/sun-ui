{
  "name": "@smug-ui/theme",
  "version": "1.0.0",
  "description": "Pre-configured MUI themes with beautiful defaults. Light and dark themes included.",
  "homepage": "https://smug-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tahmidbintaslim/smug-ui.git",
    "directory": "packages/theme"
  },
  "keywords": [
    "mui",
    "theme",
    "dark-mode",
    "light-theme",
    "design-system"
  ],
  "author": "Tahmid Bin Taslim <hello@tahmir.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smug-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@mui/material": "^7.3.5",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.5",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-links": "^10.1.4",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.24.2",
    "@types/react": "^19.2.7",
    "eslint-plugin-storybook": "^10.1.4",
    "typescript": "^5.9.3"
  }
}
